# Copiar este archivo como .env y completar con los valores reales.
# .env no se versiona: contiene la contrasena de la base de datos.

PGHOST=localhost
PGPORT=5432
PGDATABASE=amasaapp
PGUSER=amasaapp
PGPASSWORD=

PORT=3000

# Clave con la que se firman los tokens de sesion.
# Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=
